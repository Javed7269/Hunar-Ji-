        allow update: if isOwner(userId) && isValidId(addressId) && isValidAddress(incoming()) &&
                         incoming().keys().hasOnly(['label', 'recipientName', 'mobile', 'houseFlatNo', 'streetRoad', 'areaLocality', 'fullAddress', 'landmark', 'city', 'district', 'state', 'pincode', 'gpsLocation', 'defaultAddress', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(addressId);
