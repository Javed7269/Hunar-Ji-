                         incoming().keys().hasOnly(['productId', 'title', 'category', 'sellerId', 'sellerName', 'price', 'originalPrice', 'quantity', 'variant', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) && isValidId(cartItemId) && isValidCartItem(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'variant', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(cartItemId);
      }

      match /wishlist/{productId} {
        allow get: if isOwner(userId) && isValidId(productId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(productId) && isValidWishlistItem(incoming()) &&
                         incoming().keys().hasOnly(['productId', 'title', 'category', 'price', 'originalPrice', 'discountPercent', 'createdAt']);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /addresses/{addressId} {
        allow get: if isOwner(userId) && isValidId(addressId);
