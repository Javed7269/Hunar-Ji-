        allow update: if isValidId(notifId) && (isOwner(userId) || isAdmin()) && isValidNotification(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(notifId) && (isOwner(userId) || isAdmin());
