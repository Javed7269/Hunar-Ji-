                       isValidUserProfile(incoming()) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'role', 'walletBalance', 'loyaltyPoints', 'verified', 'online', 'blocked', 'createdAt', 'updatedAt']) &&
                       (isAdmin() || (
                         incoming().role in ['CUSTOMER', 'MECHANIC', 'SELLER', 'DELIVERY'] &&
                         incoming().verified == false &&
                         incoming().blocked == false &&
                         (!('kycStatus' in incoming()) || incoming().kycStatus in ['NOT_SUBMITTED', 'SUBMITTED', 'PENDING']) &&
                         (!('accountStatus' in incoming()) || incoming().accountStatus == 'ACTIVE')
                       ));
      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           isOwner(userId) &&
                           incoming().role in ['CUSTOMER', 'MECHANIC', 'SELLER', 'DELIVERY'] &&
                           incoming().verified == existing().verified &&
                           incoming().blocked == existing().blocked &&
                           incoming().walletBalance <= existing().walletBalance &&
                           (!('rewardPoints' in incoming()) || incoming().rewardPoints <= existing().get('rewardPoints', 0) + 500) &&
                           (!('accountStatus' in incoming()) || incoming().accountStatus == existing().get('accountStatus', 'ACTIVE')) &&
                           (!('kycStatus' in incoming()) || incoming().kycStatus in ['NOT_SUBMITTED', 'SUBMITTED', 'PENDING'] || incoming().kycStatus == existing().get('kycStatus', 'NOT_SUBMITTED')) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'email', 'phone', 'role', 'hunarUserId', 'kycStatus',
                             'city', 'district', 'state', 'online', 'walletBalance', 'loyaltyPoints',
                             'rewardPoints', 'dailyRewardCount', 'dailyRewardDate',
                             'shopName', 'shopDescription', 'shopLogoUrl', 'shopBannerUrl', 'shopHours', 'shopReturnPolicy',
                             'vehicleInfo', 'skills', 'referralCode',
                             'dob', 'gender', 'profilePhotoUri', 'passwordHash', 'termsAccepted', 'kycConsentAccepted',
                             'updatedAt'
                           ])
