      allow get: if isSignedIn() && isValidId(locationId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(locationId) && isValidLocation(incoming());
      allow delete: if isAdmin() && isValidId(locationId);
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(incoming()) && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
