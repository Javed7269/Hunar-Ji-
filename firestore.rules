                         incoming().type in ['REWARDED_AD', 'BONUS', 'PROMO'] &&
                         incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 140 &&
                         incoming().rewardToken is string && incoming().rewardToken.size() >= 4 && incoming().rewardToken.size() <= 128 &&
